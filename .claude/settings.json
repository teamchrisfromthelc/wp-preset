{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(composer:*)",
			"Bash(vendor/bin/phpcs:*)",
			"Bash(vendor/bin/phpcbf:*)",
			"Bash(vendor/bin/phpstan:*)",
			"Bash(vendor/bin/phpunit:*)",
			"Bash(npm run:*)",
			"Bash(npx wp-scripts:*)",
			"Bash(npx wp-env:*)",
			"Bash(wp:*)"
		]
	}
}
